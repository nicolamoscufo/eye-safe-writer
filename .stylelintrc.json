{
  "extends": "stylelint-config-obsidianmd",
  "rules": {
    "plugin/no-unsupported-browser-features": [true, {
      "severity": "warning",
      "browsers": ["electron >= 39"]
    }],
    "selector-class-pattern": "^(?:[a-z][a-z0-9-]*|HyperMD-[a-z0-9-]+|cm-selectionBackground|cm-activeLine)$",
    "selector-type-no-unknown": [true, { "ignore": ["custom-elements"], "severity": "warning" }]
  }
}
